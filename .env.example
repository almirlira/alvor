# Copilot DRE — configuracao local (copie para .env e preencha)
# Provedor de IA: anthropic-direct (real) | mock (sem rede, respostas fixas)
LLM_PROVIDER=anthropic-direct
ANTHROPIC_API_KEY=cole-aqui-a-chave
# Modelo: claude-opus-5 (padrao-ouro) | claude-sonnet-5 (mais rapido)
ANTHROPIC_MODEL=claude-opus-5
# Portas
API_PORT=3800

